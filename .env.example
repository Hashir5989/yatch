# =========================================================================
# ASMARATY Luxury Yachts — Production Environment Variables
# =========================================================================
# Hostinger VPS & Production Server Configuration
# Copy this file to .env.local on your VPS (/var/www/yatch/.env.local)
# DO NOT commit real passwords or production keys to Git.
# =========================================================================

# -------------------------------------------------------------------------
# 1. Primary PostgreSQL Database Connection String
# -------------------------------------------------------------------------
# Hosted PostgreSQL instance (Supabase, Hostinger PostgreSQL, or local VPS PG).
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://asmaraty_user:STRONG_SECURE_PASSWORD@127.0.0.1:5432/asmaraty_db"

# -------------------------------------------------------------------------
# 2. Admin Authentication & Session Security
# -------------------------------------------------------------------------
# Generate a random 64-character hex string:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="replace_with_a_secure_random_64_character_hex_secret_key"

# -------------------------------------------------------------------------
# 3. Hostinger Business Email / SMTP Configuration
# -------------------------------------------------------------------------
# Client's Hostinger Business Email credentials.
# Hostinger SMTP Host: smtp.hostinger.com
# Port 465 (SSL/TLS - Recommended) or Port 587 (STARTTLS)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@asmaraty.ae"
SMTP_PASS="YOUR_HOSTINGER_EMAIL_PASSWORD"

# Sender header (MUST match or belong to the authenticated client domain)
SMTP_FROM="\"ASMARATY Luxury Yachts\" <info@asmaraty.ae>"

# Shipyard notification recipient for customer sea trials & commissions
CONTACT_RECIPIENT_EMAIL="sales@asmaraty.ae"

# -------------------------------------------------------------------------
# 4. Public Domain & Server Environment
# -------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_SITE_URL="https://asmaraty.ae"
